PANTA_API_BASE_URL=https://live-api.panta.market/api/v1/
PANTA_API_KEY=
PANTA_API_TIMEOUT_SECONDS=10
PANTA_ADAPTER_URL=http://127.0.0.1:8081
SOLANA_RPC_URL=
DATABASE_URL=postgresql://prophet:prophet@localhost:5432/prophet
REDIS_URL=redis://localhost:6379
AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=apodex/apodex-1.1-mini:free
# Comma-separated list of allowed CORS origins for the intelligence service (production only)
# Example: https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=

# JWT Authentication (required for production)
# Generate a secure secret: openssl rand -hex 32
JWT_SECRET=
# Token expiry duration (e.g., 24h, 168h for 7 days)
JWT_EXPIRY=24h
# Comma-separated list of allowed audiences
JWT_AUDIENCE=qevryn-api

# Background alert-ingestion worker (services/gateway/cmd/worker).
# MARKET_ENGINE_BIN is required: without the deterministic engine the worker
# produces no signals and therefore no alerts, so it fails fast rather than
# running silently blind. PROPHET_SYNC_INTERVAL_SECONDS defaults to 300 and is
# clamped to [30, 86400]. (Legacy env var name; will be renamed in future)
MARKET_ENGINE_BIN=
PROPHET_SYNC_INTERVAL_SECONDS=
# Advisory lock key for single-instance worker. Must be unique per deployment
# sharing the same database. Default: 0x50524F5048455445 (ASCII "PROPHETE").
# Legacy constant; future versions will use a Qevryn-branded key.
WORKER_ADVISORY_LOCK_KEY=
