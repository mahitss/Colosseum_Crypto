PANTA_API_BASE_URL=https://live-api.panta.market/api/v1/
PANTA_API_KEY=
PANTA_API_TIMEOUT_SECONDS=10
PANTA_ADAPTER_URL=http://127.0.0.1:8081
SOLANA_RPC_URL=
DATABASE_URL=postgresql://prophet:prophet@localhost:5432/prophet
REDIS_URL=redis://localhost:6379
AI_PROVIDER=openai
AI_API_KEY=

# Background alert-ingestion worker (services/gateway/cmd/worker).
# MARKET_ENGINE_BIN is required: without the deterministic engine the worker
# produces no signals and therefore no alerts, so it fails fast rather than
# running silently blind. PROPHET_SYNC_INTERVAL_SECONDS defaults to 300 and is
# clamped to [30, 86400].
MARKET_ENGINE_BIN=
PROPHET_SYNC_INTERVAL_SECONDS=
